# Backend API base URL for Frontend build (Vite environment variable)
# If frontend & backend share the same domain/subdomain via Nginx reverse proxy (Default for siva-balaji-billing.gemshine.tech):
# VITE_API_URL=/api
#
# If backend is on a separate subdomain:
# VITE_API_URL=https://siva-balaji-billing.gemshine.tech/api
#
# Local Development:
# VITE_API_URL=http://localhost:5012/api
VITE_API_URL=/api
