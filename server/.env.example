# Backend Server Port (Default VPS port)
PORT=5012

# Environment Mode (development / production)
NODE_ENV=production

# Database Connection (Local VPS MongoDB or MongoDB Atlas URI)
# Local VPS MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/siva_balaji_billing
# Atlas Cloud MongoDB:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.txhuc3s.mongodb.net/siva_balaji_billing?retryWrites=true&w=majority

# Frontend Client URL for CORS (Set your Hostinger subdomain or domain)
CORS_ORIGIN=https://siva-balaji-billing.gemshine.tech

# Cloudinary Storage Configuration for PDF / File Uploads
# Get these from your Cloudinary Dashboard (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
